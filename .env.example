# ---- LLM providers -------------------------------------------------------
# Two independent providers. The first is tried first; if its key is
# rate-limited, dead, or its model retired, the call falls through to the
# second instead of dropping the agents back to deterministic rule-based text.
# Swap to groq,gemini for lower latency.
LLM_PROVIDER_ORDER=gemini,groq

# Google Gemini (free developer key: https://aistudio.google.com/)
GEMINI_API_KEY=
# Gemini model id. Override if the default is retired.
GEMINI_MODEL=gemini-3.6-flash
# Optional extra keys — each one adds another slice of free per-minute quota.
GEMINI_API_KEY_2=

# Groq Cloud (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY_2=

# NewsAPI.org key (free: https://newsapi.org/register)
# Optional — falls back to Yahoo Finance RSS, then to simulated headlines.
NEWS_API_KEY=

# Neon / PostgreSQL connection string (optional, falls back to local SQLite)
# Example: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Gmail SMTP for OTP verification emails (optional).
# If blank, OTP codes are printed to the backend console for local testing.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
