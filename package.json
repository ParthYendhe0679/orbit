{
  "name": "testttai",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,AI,STREAM\" -c \"cyan,magenta,yellow\" \"npm run dev:backend\" \"npm run dev:ai\" \"npm run dev:stream\"",
    "dev:backend": "cd backend && go run .",
    "dev:ai": "cd ai-service && python -m uvicorn main:app --reload --port 8001",
    "dev:stream": "cd go-stream && go run . --port 8002",
    "build": "esbuild src/index.ts --bundle --outfile=frontend/app.bundle.js --format=iife --target=es2022 --sourcemap",
    "watch": "esbuild src/index.ts --bundle --outfile=frontend/app.bundle.js --format=iife --target=es2022 --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "start:all": "run_all.bat",
    "build:backend": "cd backend && go build -o bin/backend.exe .",
    "test": "npm run typecheck && cd backend && go test ./... && cd ../go-stream && go test ./... && cd .. && python -m pytest tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/clerk-js": "^6.31.1",
    "lightweight-charts": "^5.2.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
