# ---- LLM providers -------------------------------------------------------
# Two independent providers. The first is tried first; if its key is
# rate-limited, dead, or its model retired, the call falls through to the
# second instead of dropping the agents back to deterministic rule-based text.
# Swap to groq,gemini for lower latency.
LLM_PROVIDER_ORDER=gemini,groq

# Google Gemini (free developer key: https://aistudio.google.com/)
GEMINI_API_KEY=
# Gemini model id. Override if the default is retired.
GEMINI_MODEL=gemini-3.6-flash
# Optional extra keys (_2 ... _9) — each one adds another slice of free quota.
# Calls rotate across keys; a key that hits its rate limit or quota is skipped
# until the provider's retry window passes, then rejoins automatically.
GEMINI_API_KEY_2=

# Groq Cloud (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY_2=

# NewsAPI.org key (free: https://newsapi.org/register)
# Optional — falls back to Yahoo Finance RSS, then to simulated headlines.
NEWS_API_KEY=

# Neon / PostgreSQL connection string (optional, falls back to local SQLite)
# Example: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Gmail SMTP for OTP verification emails (optional).
# If blank, OTP codes are printed to the backend console for local testing.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=

# Go WebSocket tick hub (orbit-stream) on :8002 (8000 = gateway, 8001 = ai-service).
# The ai-service publishes real quotes to it; browsers subscribe via the gateway's /ws/stream.
STREAM_HUB_URL=http://127.0.0.1:8002/publish
STREAM_SERVICE_URL=http://127.0.0.1:8002

# ---- Go gateway security ----------------------------------------------------
# Clerk (https://dashboard.clerk.com). The gateway derives the token issuer and
# JWKS URL from the publishable key and verifies every Clerk session token.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional overrides / hardening:
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Origins allowed in the token's azp claim (comma-separated), e.g. http://localhost:8000
CLERK_AUTHORIZED_PARTIES=
# Signing key for the gateway's HttpOnly session cookie (32+ random characters).
# Unset = a per-process key: every sign-in ends when the gateway restarts.
ORBIT_SESSION_SECRET=
ORBIT_SESSION_TTL=12h
# Extra browser origins allowed to call the gateway cross-origin (default: none;
# the frontend is served same-origin by the gateway).
ORBIT_ALLOWED_ORIGINS=
# Gateway PostgreSQL pool size for its native read endpoints.
DB_MAX_CONNS=10

# ---- Auto-Trade Bot ----------------------------------------------------------
# Shared secret between the Go gateway, the ai-service and orbit-stream. The
# gateway sends it with every request it forwards (plus the verified X-User-ID);
# the ai-service trusts identity headers only from callers holding it. Without
# it only loopback callers are trusted. Required for docker-compose. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORBIT_INTERNAL_TOKEN=
# Where the ai-service reaches the gateway's /internal/events/publish.
GATEWAY_INTERNAL_URL=http://127.0.0.1:8000
# Set to false on gateway replicas that must never schedule the bot.
BOT_SCHEDULER_ENABLED=true
# Pacing (seconds). The scan interval defaults to the previous 180 s autotrade
# cadence to stay inside news / LLM / market-data quotas.
BOT_SCAN_INTERVAL_SECONDS=180
BOT_TICK_SECONDS=10
BOT_MAX_CONCURRENCY=8
# Placeholders pending product decisions (see the bot report):
BOT_SUPPORTED_LEVERAGE=1,2,3,5
BOT_BLOCKED_RISK_LEVELS=CRITICAL
BOT_MIN_DECISION_CLARITY=MODERATE
BOT_MIN_OPPORTUNITY_LEVEL=MODERATE
# realized | realized_plus_unrealized
BOT_MAX_LOSS_BASIS=realized_plus_unrealized
BOT_PROTECT_POSITIONS_AFTER_STOP=true

# Alpha Vantage Market Data API Key (free/premium key from https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=

# Aiven Valkey (Redis-compatible) Real-Time Cache Layer
VALKEY_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
VALKEY_HOST=
VALKEY_PORT=
VALKEY_USERNAME=default
VALKEY_PASSWORD=
VALKEY_SSL=true
REDIS_URL=
